# Format-generic lakehouse storage engine support
# (specs/lakehouse/02-sql-surface.md). SQL-visible names live in the
# `lakehouse` schema (RULES.md §4); Iceberg is the first FORMAT layer.
comment = 'Lakehouse storage engine support (open table formats)'
default_version = '1.3'
