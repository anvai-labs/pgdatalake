-- COUNT correctness contract (spec 16, "COUNT must be computed at
-- execution"). The former plan-time elisions — the managed planner-hook
-- rewrite (former count_elision.c) and the FDW upper Const path — are
-- GATED OFF: a plan-time Const served a stale count under prepared-plan
-- reuse, and the managed rewrite stripped the rtable so relation
-- permission checks never ran. These tests pin the behavior any successor
-- execution-time path must preserve.
-- This test runs OFFLINE on purpose: the ledger lives in Postgres, so a
-- staged-serve scan works against the dead endpoint below.
CREATE EXTENSION IF NOT EXISTS lakehouse;
NOTICE:  extension "lakehouse" already exists, skipping
ALTER EXTENSION lakehouse UPDATE; -- managed_count (v1.3)
NOTICE:  version "1.3" of extension "lakehouse" is already installed
SELECT lakehouse.version();
          version           
----------------------------
 pgdatalake-core 0.1.0 (M0)
(1 row)

SET lakehouse.write_mode = 'staged';
CREATE TABLE cnt_elide (id bigint, name text) USING lakehouse;
DO $$ BEGIN CREATE FOREIGN DATA WRAPPER ce_wrapper
    HANDLER lakehouse.lakehouse_fdw_handler;
EXCEPTION WHEN duplicate_object THEN NULL; END $$;
DO $$ BEGIN CREATE SERVER ce_srv FOREIGN DATA WRAPPER ce_wrapper
    OPTIONS (endpoint 'http://127.0.0.1:9', warehouse 'wh',
             s3_endpoint 'http://s3:9000');
EXCEPTION WHEN duplicate_object THEN NULL; END $$;
CREATE USER MAPPING IF NOT EXISTS FOR CURRENT_USER SERVER ce_srv;
SELECT lakehouse.attach_table('cnt_elide'::regclass, 'analytics.cnt_elide', 'ce_srv');
 attach_table 
--------------
 
(1 row)

INSERT INTO cnt_elide SELECT g, 'e-'||g FROM generate_series(1, 5) g;
-- execution-time successor (spec 16): the plan is a bare Result whose
-- target is the volatile lakehouse.managed_count(relid) call — the ONLY
-- plan input is the relation descriptor; NO count literal may appear
EXPLAIN (VERBOSE, COSTS OFF) SELECT count(*) FROM cnt_elide;
                   QUERY PLAN                    
-------------------------------------------------
 Result
   Output: lakehouse.managed_count('16997'::oid)
(2 rows)

SELECT count(*) AS exact FROM cnt_elide;
 exact 
-------
     5
(1 row)

-- prepared plans stay FRESH across commits (spec 16 blocker 1: a generic
-- prepared COUNT returned 2 before and after a committed third row)
PREPARE cnt_p AS SELECT count(*) FROM cnt_elide;
EXECUTE cnt_p;
 count 
-------
     5
(1 row)

INSERT INTO cnt_elide VALUES (100, 'x');
EXECUTE cnt_p;
 count 
-------
     6
(1 row)

INSERT INTO cnt_elide VALUES (200, 'y');
EXECUTE cnt_p;
 count 
-------
     7
(1 row)

DEALLOCATE cnt_p;
-- savepoint rollback removes staged rows: the count must reflect pruning
BEGIN;
INSERT INTO cnt_elide VALUES (300, 'a');
SAVEPOINT s1;
INSERT INTO cnt_elide VALUES (400, 'b');
ROLLBACK TO s1;
COMMIT;
SELECT count(*) AS after_savepoint_prune FROM cnt_elide;
 after_savepoint_prune 
-----------------------
                     8
(1 row)

-- permission semantics: a role without SELECT on the table must NOT be
-- able to read its count (the gated-off hook answered from the ledger
-- without any relation permission check)
CREATE ROLE cnt_deny;
SET ROLE cnt_deny;
SELECT count(*) FROM cnt_elide;
ERROR:  permission denied for table cnt_elide
RESET ROLE;
-- negative control: a WHERE clause forces the normal scan path
-- (dead endpoint -> loud failure; no metadata shortcut may answer it)
SELECT count(*) AS filtered FROM cnt_elide WHERE id = 1;
 filtered 
----------
        1
(1 row)

