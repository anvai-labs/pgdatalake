 src/backend/access/common/reloptions.c        | 56 +++++++++++++++++++
 src/include/access/reloptions.h               |  3 +
 .../tableam_reloptions/tableam_reloptions.c   | 43 +++-----------
 4 files changed, 72 insertions(+), 37 deletions(-)

